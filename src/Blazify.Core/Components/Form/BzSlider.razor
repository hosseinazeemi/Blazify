@namespace BzCore.Components.Form
@inherits BzComponentBase

@if (Visible)
{
    <div class="bz-slider @Class" style="@RootStyle()" id="@Id">
        @if (!string.IsNullOrEmpty(Label))
        {
            <div class="bz-slider__top">
                <label>@Label</label>
                @if (ShowValue)
                {
                    <span class="bz-slider__val">@Value</span>
                }
            </div>
        }
        <input type="range" class="bz-slider__input" min="@Min" max="@Max" step="@Step"
               value="@Value" disabled="@Disabled"
               style="@($"--p:{Percent}%")"
               @oninput="OnInput" />
        @if (string.IsNullOrEmpty(Label) && ShowValue)
        {
            <span class="bz-slider__val">@Value</span>
        }
    </div>
}

@code {
    /// <summary>two-way bindable</summary>
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    /// <summary>Min</summary>
    [Parameter] public double Min { get; set; } = 0;
    /// <summary>Max</summary>
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>Step increment</summary>
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowValue { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    double Percent => Max > Min ? (Value - Min) / (Max - Min) * 100 : 0;

    async Task OnInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            Value = v;
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(v);
        }
    }
}
