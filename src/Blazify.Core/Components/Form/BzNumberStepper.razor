@namespace BzCore.Components.Form
@inherits BzComponentBase

@if (Visible)
{
    <div class="bz-stepper @Class" style="@RootStyle()" id="@Id">
        @if (!string.IsNullOrEmpty(Label)) { <label class="bz-stepper__label">@Label</label> }
        <div class="bz-stepper__box">
            <button type="button" class="bz-stepper__btn" disabled="@(Disabled || Value <= Min)" @onclick="@(() => Step(-StepValue))"><i class="fa-solid fa-minus"></i></button>
            <input class="bz-stepper__input" type="text" value="@Value" disabled="@Disabled" @onchange="OnType" />
            <button type="button" class="bz-stepper__btn" disabled="@(Disabled || Value >= Max)" @onclick="@(() => Step(StepValue))"><i class="fa-solid fa-plus"></i></button>
        </div>
    </div>
}

@code {
    /// <summary>Current value: two-way binding</summary>
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    /// <summary>min value</summary>
    [Parameter] public double Min { get; set; } = double.MinValue;
    /// <summary>max value</summary>
    [Parameter] public double Max { get; set; } = double.MaxValue;
    /// <summary>step value</summary>
    [Parameter] public double StepValue { get; set; } = 1;
    /// <summary>display name or title</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    async Task Step(double delta) => await SetClamped(Value + delta);

    async Task OnType(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v)) await SetClamped(v);
        else { await ValueChanged.InvokeAsync(Value); } // revert display
    }

    async Task SetClamped(double v)
    {
        Value = Math.Clamp(v, Min, Max);
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
    }
}
